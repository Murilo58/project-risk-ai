# Copy this file to .env and fill in the values for your local environment.
# Never commit .env — it is already covered by .gitignore.

# PostgreSQL connection string.
# Local development (matches docker-compose.yml):
DATABASE_URL="postgresql://project_risk_ai:project_risk_ai@localhost:5432/project_risk_ai?schema=public"

# Anthropic API key used exclusively by server-side code (AI Risk Advisor).
# Get one at https://console.anthropic.com/
# Never exposed to the frontend and never committed.
# If unset, the AI Risk Advisor returns a clear "unavailable" error and the
# rest of the application keeps working normally (see RNF03 in PRD.md).
ANTHROPIC_API_KEY=""

# Optional: override the model used by the AI Risk Advisor (defaults to
# claude-opus-5). Lower-cost option for frequent use: claude-sonnet-5.
ANTHROPIC_MODEL=""

# Shared secret required by the /api/cron/health-snapshot endpoint (Phase 4+).
# Generate any random string, e.g.: openssl rand -hex 32
CRON_SECRET=""

# --- Authentication (single-admin MVP, see ARCHITECTURE.md §9) ---

# Secret used to sign the session cookie (JWT/HS256). Generate a random
# value, e.g.: openssl rand -base64 32
# Never reuse CRON_SECRET here — keep signing secrets independent per purpose.
AUTH_SECRET=""

# The only e-mail allowed to log in. There is no signup and no User table —
# this is the sole authorized account for the MVP.
AUTH_ADMIN_EMAIL=""

# Scrypt hash of the admin password, in "salt:derivedKeyHex" format. Never
# put the plaintext password here. Generate it locally with:
#   node scripts/hash-password.mjs
AUTH_ADMIN_PASSWORD_HASH=""
